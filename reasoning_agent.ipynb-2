    "if RECHECK_RESULTS:\n",
    "    folio = data[data[\"dataset\"] == \"FOLIO\"]\n",
    "    uncertain = pd.DataFrame([\n",
    "        {\"data\": \"FOLIO (all splits)\", \"Uncertain\": \"removed\",       **summary(folio[~folio[\"uncertain\"]])},\n",
    "        {\"data\": \"FOLIO (all splits)\", \"Uncertain\": \"kept as False\", **summary(folio)},\n",
    "        {\"data\": \"All three datasets\", \"Uncertain\": \"removed\",       **summary(data[~data[\"uncertain\"]])},\n",
    "        {\"data\": \"All three datasets\", \"Uncertain\": \"kept as False\", **summary(data)},\n",
    "    ])\n",
    "    print(uncertain.to_string(index=False))\n",
