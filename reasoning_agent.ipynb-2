   "outputs": [],
   "source": [
    "if RECHECK_RESULTS:\n",
    "    overall = [{\"dataset\": d, **summary(g)} for d, g in main.groupby(\"dataset\", sort=False)]\n",
    "    overall.append({\"dataset\": \"All three\", **summary(main)})\n",
    "    overall = pd.DataFrame(overall)\n",
    "    print(\"All splits together, FOLIO without 'Uncertain'\\n\")\n",
    "    print(overall.to_string(index=False))\n",
    "    overall.to_csv(\"results_overall.csv\", index=False)\n",
    "else:\n",
    "    print(\"Skipped (RECHECK_RESULTS = False)\")"
   ]
