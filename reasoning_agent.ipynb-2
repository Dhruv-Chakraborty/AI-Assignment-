{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "ea0e68b3",
   "metadata": {},
   "source": [
    "# Reasoning agent\n",
    "\n",
    "Knowledge base (logic) + query → **resolution with unification** → `True` (entailed) / `False`.\n",
    "\n",
    "* Input: CSV with `id`, `context` (one formula per line), `statement`, optional `label`.\n",
    "* Output: `submission.csv` (`id, flag`), with accuracy and inference time printed.\n",
    "* Sections 1-10: the system. Sections 11-16: reproduce the reported results (only when `RECHECK_RESULTS = True`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ae6b30b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ===== Configuration =====\n",
    "INPUT_CSV = \"test.csv\"          # file to predict: id, context, statement[, label]\n",
    "OUTPUT_CSV = \"submission_test.csv\"   # predictions: id, flag\n",
    "SHOW_TRACES = 3                 # print the reasoning trace of the first N examples\n",
    "\n",
    "RECHECK_RESULTS = False     # True: reproduce the reported results (RuleTaker, CounterBench, FOLIO, ProverQA)\n",
    "RECHECK_LIMIT = None            # with RECHECK_RESULTS: examples per split (None = all)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8798ca5a",
   "metadata": {},
   "source": [
    "## 1. Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "178ba2d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import time\n",
    "import heapq\n",
    "import itertools\n",
    "from collections import defaultdict\n",
    "from dataclasses import dataclass\n",
    "from typing import NamedTuple\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "MAX_RESOLVENTS = 3000      # resolution search limits (per query)\n",
    "MAX_SECONDS = 1.0\n",
    "MAX_CLAUSE_LENGTH = 8\n",
    "MAX_TERM_DEPTH = 2"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ae9bf21b",
   "metadata": {},
   "source": [
    "## 2. Representation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "07d7ce6d",
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass(frozen=True)\n",
    "class Var:\n",
    "    name: str\n",
    "\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class Fn:                       # Skolem function term\n",
    "    name: str\n",
    "    args: tuple\n",
    "\n",
    "\n",
    "DISPLAY = {}                   \n",
    "\n",
    "\n",
    "def term_str(t):\n",
    "    if isinstance(t, Var):\n",
    "        return t.name.split(\"_\")[0]\n",
    "    if isinstance(t, Fn):\n",
    "        return f\"{t.name}({', '.join(map(term_str, t.args))})\"\n",
    "    return DISPLAY.get(t, t)\n",
    "\n",
    "\n",
    "class Literal(NamedTuple):\n",
    "    positive: bool\n",
    "    pred: str\n",
    "    args: tuple\n",
    "\n",
    "    def negate(self):\n",
    "        return Literal(not self.positive, self.pred, self.args)\n",
    "\n",
    "    def __str__(self):\n",
    "        text = DISPLAY.get(self.pred, self.pred)\n",
    "        if self.args:\n",
    "            text += f\"({', '.join(map(term_str, self.args))})\"\n",
    "        return text if self.positive else \"¬\" + text\n",
    "\n",
    "\n",
    "# Formulas: (\"atom\", Literal) (\"not\", f) (\"and\"|\"or\"|\"implies\"|\"iff\"|\"xor\", f, g) (\"forall\"|\"exists\", Var, f)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "775e4ac5",
   "metadata": {},
   "source": [
    "## 3. Parser"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd3f5b7d",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ParseError(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "TOKEN_RE = re.compile(r\"\"\"\\s*(<=>|<->|->|=>|⇒|⇔|⟷|⟺|⟶|⟹|⊃|≡|⊻|⊤|⊥|∀|∃|¬|∧|∨|⊕|→|↔|≠|=|~|!|&|\\||\\(|\\)|,|\\w+(?:[-'.]\\w+)*)\"\"\")\n",
    "OPERATORS = {\"∀\": \"forall\", \"forall\": \"forall\", \"∃\": \"exists\", \"exists\": \"exists\",\n",
    "             \"¬\": \"not\", \"~\": \"not\", \"!\": \"not\", \"not\": \"not\", \"∧\": \"and\", \"&\": \"and\", \"and\": \"and\",\n",
    "             \"∨\": \"or\", \"|\": \"or\", \"or\": \"or\", \"⊕\": \"xor\", \"⊻\": \"xor\", \"xor\": \"xor\",\n",
    "             \"→\": \"implies\", \"->\": \"implies\", \"=>\": \"implies\", \"⇒\": \"implies\", \"⟶\": \"implies\", \"⟹\": \"implies\", \"⊃\": \"implies\", \"implies\": \"implies\",\n",
    "             \"↔\": \"iff\", \"<->\": \"iff\", \"⇔\": \"iff\", \"⟷\": \"iff\", \"⟺\": \"iff\", \"≡\": \"iff\", \"<=>\": \"iff\", \"iff\": \"iff\"}\n",
    "FREE_VARIABLES = {\"x\", \"y\", \"z\", \"w\", \"X\", \"Y\", \"Z\", \"W\"}   # unquantified x/y/z/w (or X/Y/Z/W) are variables\n",
    "_ids = itertools.count()\n",
    "\n",
    "\n",
    "class _WideScope(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class FOLParser:\n",
    "    \"\"\"Recursive descent. Weakest to strongest: ↔ → ⊕ ∨ ∧ ¬/∀/∃ ; → is right-associative.\"\"\"\n",
    "\n",
    "    def __init__(self, text, wide=False):\n",
    "        self.toks, pos = [], 0\n",
    "        text = text.strip()\n",
    "        while pos < len(text):\n",
    "            m = TOKEN_RE.match(text, pos)\n",
    "            if not m or m.end() == pos:\n",
    "                raise ParseError(f\"bad character {text[pos]!r}\")\n",
    "            self.toks.append(OPERATORS.get(m.group(1), m.group(1)))\n",
    "            pos = m.end()\n",
    "        self.i, self.scope, self.wide = 0, [], wide\n",
    "        self.quantified = {self.toks[k + 1] for k in range(len(self.toks) - 1) if self.toks[k] in (\"forall\", \"exists\")}\n",
    "\n",
    "    def peek(self):\n",
    "        return self.toks[self.i] if self.i < len(self.toks) else None\n",
    "\n",
    "    def take(self, want=None):\n",
    "        t = self.peek()\n",
    "        if t is None or (want and t != want):\n",
    "            raise ParseError(f\"expected {want}, got {t}\")\n",
    "        self.i += 1\n",
    "        return t\n",
    "\n",
    "    def parse(self):\n",
    "        f = self.binary(0)\n",
    "        if self.peek() is not None:\n",
    "            raise ParseError(f\"unexpected {self.peek()}\")\n",
    "        return f\n",
    "\n",
    "    LEVELS = [\"iff\", \"implies\", \"xor\", \"or\", \"and\"]\n",
    "\n",
    "    def binary(self, level):\n",
    "        if level == len(self.LEVELS):\n",
    "            return self.unary()\n",
    "        op = self.LEVELS[level]\n",
    "        left = self.binary(level + 1)\n",
    "        if op == \"implies\":\n",
    "            if self.peek() == \"implies\":\n",
    "                self.take()\n",
    "                return (\"implies\", left, self.binary(level))     # right-associative\n",
    "            return left\n",
    "        while self.peek() == op:\n",
    "            self.take()\n",
    "            left = (op, left, self.binary(level + 1))\n",
    "        return left\n",
    "\n",
    "    def unary(self):\n",
    "        t = self.peek()\n",
    "        if t == \"not\":\n",
    "            self.take()\n",
    "            return (\"not\", self.unary())\n",
    "        if t in (\"forall\", \"exists\"):\n",
    "            self.take()\n",
    "            name = self.name()\n",
    "            var = Var(f\"{name}_{next(_ids)}\")\n",
    "            self.scope.append((name, var))\n",
    "            if self.peek() == \"(\" and not self.wide:\n",
    "                body = self.unary()\n",
    "            elif self.peek() in (\"forall\", \"exists\", \"not\"):\n",
    "                body = self.unary()\n",
    "            else:\n",
    "                body = self.binary(0)\n",
    "            self.scope.pop()\n",
    "            return (t, var, body)\n",
    "        if t == \"(\":\n",
    "            self.take()\n",
    "            f = self.binary(0)\n",
    "            self.take(\")\")\n",
    "            return f\n",
    "        if t in (\"⊤\", \"⊥\") or (str(t).lower() in (\"true\", \"false\") and self.toks[self.i + 1:self.i + 2] != [\"(\"]):\n",
    "            self.take()\n",
    "            return (\"atom\", Literal(True, \"⊤\" if t == \"⊤\" or str(t).lower() == \"true\" else \"⊥\", ()))\n",
    "        name = self.name()\n",
    "        if self.peek() in (\"=\", \"≠\"):\n",
    "            op = self.take()\n",
    "            return (\"atom\", Literal(op == \"=\", \"equals\", (self.term_of(name), self.term())))\n",
    "        args = self.args() if self.peek() == \"(\" else ()\n",
    "        if args and self.peek() in (\"=\", \"≠\"):                  # f(a) = b : equality between terms\n",
    "            op = self.take()\n",
    "            return (\"atom\", Literal(op == \"=\", \"equals\", (Fn(name.lower(), args), self.term())))\n",
    "        DISPLAY.setdefault(name.lower(), name)\n",
    "        return (\"atom\", Literal(True, name.lower(), args))\n",
    "\n",
    "    def args(self):\n",
    "        self.take(\"(\")\n",
    "        out = [self.term()]\n",
    "        while self.peek() == \",\":\n",
    "            self.take()\n",
    "            out.append(self.term())\n",
    "        self.take(\")\")\n",
    "        return tuple(out)\n",
    "\n",
    "    def term(self):\n",
    "        name = self.name()\n",
    "        if self.peek() == \"(\":\n",
    "            return Fn(name.lower(), self.args())\n",
    "        return self.term_of(name)\n",
    "\n",
    "    def term_of(self, name):\n",
    "        for written, var in reversed(self.scope):\n",
    "            if written == name:\n",
    "                return var\n",
    "        if name in self.quantified and not self.wide:\n",
    "            raise _WideScope()\n",
    "        if name in FREE_VARIABLES:\n",
    "            return Var(f\"{name}_free\")\n",
    "        DISPLAY.setdefault(name.lower(), name)\n",
    "        return name.lower()\n",
    "\n",
    "    def name(self):\n",
    "        t = self.take()\n",
    "        if t in OPERATORS.values() or t in (\"(\", \")\", \",\", \"=\", \"≠\"):\n",
    "            raise ParseError(f\"expected a name, got {t}\")\n",
    "        return t\n",
    "\n",
    "\n",
    "def repair_brackets(text):\n",
    "    \"\"\"Drop ')' with no matching '(' and close brackets left open.\"\"\"\n",
    "    out, depth = [], 0\n",
    "    for ch in text:\n",
    "        if ch == \")\" and depth == 0:\n",
    "            continue\n",
    "        depth += (ch == \"(\") - (ch == \")\")\n",
    "        out.append(ch)\n",
    "    return \"\".join(out) + \")\" * depth\n",
    "\n",
    "\n",
    "QUANT = r\"(?:∀|∃|\\bforall\\b|\\bexists\\b)\"\n",
    "\n",
    "\n",
    "def normalize_quantifiers(text):\n",
    "    \"\"\"∀x,y P / ∀x y. P / ∀x. P / ∀x: P  ->  ∀x ∀y (P)  (a dot or colon scopes to the end of the formula).\"\"\"\n",
    "    def expand(m):\n",
    "        q, names = m.group(1), re.split(r\"\\s*,\\s*|\\s+\", m.group(2).strip())\n",
    "        return \" \".join(f\"{q}{n}\" if q in \"∀∃\" else f\"{q} {n}\" for n in names)\n",
    "    text = re.sub(rf\"({QUANT})\\s*([A-Za-z]\\w*(?:\\s*,\\s*[A-Za-z]\\w*)+)\", expand, text)\n",
    "    text = re.sub(rf\"({QUANT})\\s*([A-Za-z]\\d*(?:\\s+[A-Za-z]\\d*)+)(?=\\s+\\(|\\s*[.:]|\\s*{QUANT})\", expand, text, flags=re.I)\n",
    "    for m in reversed(list(re.finditer(rf\"({QUANT})\\s*([A-Za-z]\\w*)\\s*[.:]\", text))):\n",
    "        depth, end = 0, len(text)\n",
    "        for k in range(m.end(), len(text)):\n",
    "            depth += (text[k] == \"(\") - (text[k] == \")\")\n",
    "            if depth < 0:\n",
    "                end = k\n",
    "                break\n",
    "        text = f\"{text[:m.start()]}{m.group(1)}{'' if m.group(1) in '∀∃' else ' '}{m.group(2)} ({text[m.end():end]}){text[end:]}\"\n",
    "    return text\n",
    "\n",
    "\n",
    "def parse_fol(text):\n",
    "    text = normalize_quantifiers(str(text))\n",
    "    for candidate in (text, repair_brackets(text)):\n",
    "        try:\n",
    "            try:\n",
    "                return FOLParser(candidate).parse()\n",
    "            except _WideScope:\n",
    "                return FOLParser(candidate, wide=True).parse()\n",
    "        except ParseError as e:\n",
    "            error = e\n",
    "    raise error"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "19a60096",
   "metadata": {},
   "source": [
    "## 4. Clause form (CNF)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "825070f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "_sk, _defs = itertools.count(), itertools.count()\n",
    "MAX_PRODUCT = 16\n",
    "\n",
    "\n",
    "def variables_of(lit):\n",
    "    found = set()\n",
    "\n",
    "    def walk(t):\n",
    "        if isinstance(t, Var):\n",
    "            found.add(t)\n",
    "        elif isinstance(t, Fn):\n",
    "            for a in t.args:\n",
    "                walk(a)\n",
    "    for a in lit.args:\n",
    "        walk(a)\n",
    "    return found\n",
    "\n",
    "\n",
    "def substitute(t, theta):\n",
    "    while isinstance(t, Var) and t in theta:\n",
    "        t = theta[t]\n",
    "    if isinstance(t, Fn):\n",
    "        return Fn(t.name, tuple(substitute(a, theta) for a in t.args))\n",
    "    return t\n",
    "\n",
    "\n",
    "def sub_lit(lit, theta):\n",
    "    return Literal(lit.positive, lit.pred, tuple(substitute(a, theta) for a in lit.args))\n",
    "\n",
    "\n",
    "def remove_arrows(f):\n",
    "    tag = f[0]\n",
    "    if tag == \"atom\":\n",
    "        return f\n",
    "    if tag == \"not\":\n",
    "        return (\"not\", remove_arrows(f[1]))\n",
    "    if tag in (\"forall\", \"exists\"):\n",
    "        return (tag, f[1], remove_arrows(f[2]))\n",
    "    a, b = remove_arrows(f[1]), remove_arrows(f[2])\n",
    "    if tag == \"implies\":\n",
    "        return (\"or\", (\"not\", a), b)\n",
    "    if tag == \"iff\":\n",
    "        return (\"and\", (\"or\", (\"not\", a), b), (\"or\", a, (\"not\", b)))\n",
    "    if tag == \"xor\":\n",
    "        return (\"and\", (\"or\", a, b), (\"or\", (\"not\", a), (\"not\", b)))\n",
    "    return (tag, a, b)\n",
    "\n",
    "\n",
    "def nnf(f, neg=False):\n",
    "    tag = f[0]\n",
    "    if tag == \"atom\":\n",
    "        return (\"atom\", f[1].negate()) if neg else f\n",
    "    if tag == \"not\":\n",
    "        return nnf(f[1], not neg)\n",
    "    if tag in (\"and\", \"or\"):\n",
    "        tag = {\"and\": \"or\", \"or\": \"and\"}[tag] if neg else tag\n",
    "        return (tag, nnf(f[1], neg), nnf(f[2], neg))\n",
    "    tag = {\"forall\": \"exists\", \"exists\": \"forall\"}[tag] if neg else tag\n",
    "    return (tag, f[1], nnf(f[2], neg))\n",
    "\n",
    "\n",
    "def skolemize(f, universals=(), theta=None):\n",
    "    theta = theta or {}\n",
    "    tag = f[0]\n",
    "    if tag == \"atom\":\n",
    "        return (\"atom\", sub_lit(f[1], theta))\n",
    "    if tag in (\"and\", \"or\"):\n",
    "        return (tag, skolemize(f[1], universals, theta), skolemize(f[2], universals, theta))\n",
    "    if tag == \"forall\":\n",
    "        return skolemize(f[2], universals + (f[1],), theta)\n",
    "    name = f\"sk{next(_sk)}\"\n",
    "    return skolemize(f[2], universals, {**theta, f[1]: Fn(name, universals) if universals else name})\n",
    "\n",
    "\n",
    "def free_vars(f, bound=frozenset()):\n",
    "    if f[0] == \"atom\":\n",
    "        return variables_of(f[1]) - bound\n",
    "    if f[0] in (\"forall\", \"exists\"):\n",
    "        return free_vars(f[2], bound | {f[1]})\n",
    "    return set().union(*(free_vars(g, bound) for g in f[1:]))\n",
    "\n",
    "\n",
    "def size(f):\n",
    "    if f[0] == \"atom\":\n",
    "        return 1, False\n",
    "    if f[0] in (\"forall\", \"exists\"):\n",
    "        return size(f[2])\n",
    "    parts = [size(g) for g in f[1:]]\n",
    "    return sum(p[0] for p in parts), f[0] in (\"iff\", \"xor\") or any(p[1] for p in parts)\n",
    "\n",
    "\n",
    "def name_big_sides(f, defs):\n",
    "    \"\"\"↔/⊕ copy both sides, so long chains explode: replace big sides by Def(vars) with ∀(Def ↔ side).\"\"\"\n",
    "    tag = f[0]\n",
    "    if tag == \"atom\":\n",
    "        return f\n",
    "    if tag == \"not\":\n",
    "        return (\"not\", name_big_sides(f[1], defs))\n",
    "    if tag in (\"forall\", \"exists\"):\n",
    "        return (tag, f[1], name_big_sides(f[2], defs))\n",
    "    a, b = name_big_sides(f[1], defs), name_big_sides(f[2], defs)\n",
    "    if tag in (\"iff\", \"xor\"):\n",
    "        a, b = [_define(s, defs) for s in (a, b)]\n",
    "    return (tag, a, b)\n",
    "\n",
    "\n",
    "def _define(f, defs):\n",
    "    atoms, nested = size(f)\n",
    "    if atoms <= 4 and not nested:\n",
    "        return f\n",
    "    args = tuple(sorted(free_vars(f), key=lambda v: v.name))\n",
    "    atom = (\"atom\", Literal(True, f\"Def{next(_defs)}\", args))\n",
    "    d = (\"iff\", atom, f)\n",
    "    for v in args:\n",
    "        d = (\"forall\", v, d)\n",
    "    defs.append(d)\n",
    "    return atom\n",
    "\n",
    "\n",
    "def distribute(f, extra):\n",
    "    \"\"\"∨ over ∧; when the product gets big, rename one side (Plaisted–Greenbaum).\"\"\"\n",
    "    tag = f[0]\n",
    "    if tag == \"atom\":\n",
    "        return [[f[1]]]\n",
    "    if tag == \"and\":\n",
    "        return distribute(f[1], extra) + distribute(f[2], extra)\n",
    "    left, right = distribute(f[1], extra), distribute(f[2], extra)\n",
    "    for side in (\"right\", \"left\"):\n",
    "        if len(left) * len(right) > MAX_PRODUCT:\n",
    "            clauses = right if side == \"right\" else left\n",
    "            if len(clauses) > 1:\n",
    "                vs = tuple(sorted(set().union(*(variables_of(l) for c in clauses for l in c)), key=lambda v: v.name))\n",
    "                lit = Literal(True, f\"Def{next(_defs)}\", vs)\n",
    "                extra += [[lit.negate()] + c for c in clauses]\n",
    "                if side == \"right\":\n",
    "                    right = [[lit]]\n",
    "                else:\n",
    "                    left = [[lit]]\n",
    "    return [a + b for a in left for b in right]\n",
    "\n",
    "\n",
    "def to_clauses(f):\n",
    "    defs = []\n",
    "    formulas = [name_big_sides(f, defs)] + defs\n",
    "    extra, out = [], []\n",
    "    for g in formulas:\n",
    "        out += distribute(skolemize(nnf(remove_arrows(g))), extra)\n",
    "    clauses = []\n",
    "    for c in out + extra:\n",
    "        c = frozenset(c)\n",
    "        if not any(l.negate() in c for l in c):\n",
    "            clauses.append(c)\n",
    "    return clauses"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "60b49d15",
   "metadata": {},
   "source": [
    "## 5. Unification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "541ca55e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def unify(x, y, theta):\n",
    "    x, y = substitute(x, theta), substitute(y, theta)\n",
    "    if x == y:\n",
    "        return theta\n",
    "    if isinstance(x, Var):\n",
    "        return None if occurs(x, y, theta) else {**theta, x: y}\n",
    "    if isinstance(y, Var):\n",
    "        return None if occurs(y, x, theta) else {**theta, y: x}\n",
    "    if isinstance(x, Fn) and isinstance(y, Fn) and x.name == y.name and len(x.args) == len(y.args):\n",
    "        for a, b in zip(x.args, y.args):\n",
    "            theta = unify(a, b, theta)\n",
    "            if theta is None:\n",
    "                return None\n",
    "        return theta\n",
    "    return None\n",
    "\n",
    "\n",
    "def occurs(v, t, theta):\n",
    "    t = substitute(t, theta)\n",
    "    return t == v or (isinstance(t, Fn) and any(occurs(v, a, theta) for a in t.args))\n",
    "\n",
    "\n",
    "def unify_lits(a, b, theta=None):\n",
    "    if a.pred != b.pred or len(a.args) != len(b.args):\n",
    "        return None\n",
    "    theta = {} if theta is None else theta\n",
    "    for x, y in zip(a.args, b.args):\n",
    "        theta = unify(x, y, theta)\n",
    "        if theta is None:\n",
    "            return None\n",
    "    return theta\n",
    "\n",
    "\n",
    "def match_term(g, s, theta):\n",
    "    \"\"\"One-way matching: only variables of the general term g may be bound.\"\"\"\n",
    "    if isinstance(g, Var):\n",
    "        if g in theta:\n",
    "            return theta if theta[g] == s else None\n",
    "        return {**theta, g: s}\n",
    "    if isinstance(g, Fn):\n",
    "        if not (isinstance(s, Fn) and s.name == g.name and len(s.args) == len(g.args)):\n",
    "            return None\n",
    "        for a, b in zip(g.args, s.args):\n",
    "            theta = match_term(a, b, theta)\n",
    "            if theta is None:\n",
    "                return None\n",
    "        return theta\n",
    "    return theta if g == s else None\n",
    "\n",
    "\n",
    "def instance_of(general, specific):\n",
    "    if (general.pred, general.positive, len(general.args)) != (specific.pred, specific.positive, len(specific.args)):\n",
    "        return False\n",
    "    theta = {}\n",
    "    for g, s in zip(general.args, specific.args):\n",
    "        theta = match_term(g, s, theta)\n",
    "        if theta is None:\n",
    "            return False\n",
    "    return True"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50bf4610",
   "metadata": {},
   "source": [
    "## 6. Resolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "df087d40",
   "metadata": {},
   "outputs": [],
   "source": [
    "_fresh = itertools.count()\n",
    "\n",
    "\n",
    "def rename(c):\n",
    "    theta = {}\n",
    "    for l in c:\n",
    "        for v in variables_of(l):\n",
    "            theta.setdefault(v, Var(f\"v{next(_fresh)}\"))\n",
    "    return frozenset(sub_lit(l, theta) for l in c)\n",
    "\n",
    "\n",
    "def canonical(c):\n",
    "    order = sorted(c, key=lambda l: (l.pred, l.positive, len(l.args)))\n",
    "    theta = {}\n",
    "    for l in order:\n",
    "        for v in sorted(variables_of(l), key=lambda v: v.name):\n",
    "            theta.setdefault(v, Var(f\"_{len(theta)}\"))\n",
    "    return tuple(sorted(repr(sub_lit(l, theta)) for l in c))\n",
    "\n",
    "\n",
    "def depth(t):\n",
    "    return 1 + max((depth(a) for a in t.args), default=0) if isinstance(t, Fn) else 0\n",
    "\n",
    "\n",
    "def resolvents(c1, c2):\n",
    "    for a in c1:\n",
    "        for b in c2:\n",
    "            if a.positive == b.positive:\n",
    "                continue\n",
    "            theta = unify_lits(a, b)\n",
    "            if theta is None:\n",
    "                continue\n",
    "            r = frozenset(sub_lit(l, theta) for l in (c1 - {a}) | (c2 - {b}))\n",
    "            if any(l.negate() in r for l in r):\n",
    "                continue\n",
    "            yield r\n",
    "            for x, y in itertools.combinations(r, 2):          # factoring\n",
    "                if x.positive == y.positive and x != y:\n",
    "                    t = unify_lits(x, y)\n",
    "                    if t is not None:\n",
    "                        yield frozenset(sub_lit(l, t) for l in r)\n",
    "\n",
    "\n",
    "def resolution(kb, goal, fast=True):\n",
    "    \"\"\"Set-of-support resolution, shortest clause first.\n",
    "    fast=True adds: a (predicate, sign) index to pick only partners that can resolve,\n",
    "    unit subsumption (drop clauses already implied by a unit clause) and\n",
    "    unit simplification (delete literals contradicted by a unit clause).\"\"\"\n",
    "    start = time.perf_counter()\n",
    "    clauses, origin, seen, usable, queue = [], [], set(), [], []\n",
    "    index = defaultdict(set)        # (pred, positive) -> ids of usable clauses\n",
    "    units = defaultdict(list)       # (pred, positive) -> unit literals\n",
    "\n",
    "    def simplify(c):\n",
    "        for l in c:\n",
    "            if any(instance_of(u, l) for u in units[(l.pred, l.positive)]):\n",
    "                return None                                        # subsumed by a unit\n",
    "        return frozenset(l for l in c\n",
    "                         if not any(instance_of(u, l.negate()) for u in units[(l.pred, not l.positive)]))\n",
    "\n",
    "    def store(c, how):\n",
    "        key = canonical(c)\n",
    "        if key in seen:\n",
    "            return None\n",
    "        seen.add(key)\n",
    "        clauses.append(c)\n",
    "        origin.append(how)\n",
    "        if len(c) == 1:\n",
    "            l = next(iter(c))\n",
    "            units[(l.pred, l.positive)].append(l)\n",
    "        return len(clauses) - 1\n",
    "\n",
    "    def use(i):\n",
    "        usable.append(i)\n",
    "        for l in clauses[i]:\n",
    "            index[(l.pred, l.positive)].add(i)\n",
    "\n",
    "    for c in kb:\n",
    "        i = store(c, \"premise\")\n",
    "        if i is not None:\n",
    "            use(i)\n",
    "    for c in goal:\n",
    "        i = store(c, \"negated query\")\n",
    "        if i is not None:\n",
    "            heapq.heappush(queue, (len(c), i))\n",
    "\n",
    "    generated = 0\n",
    "    while queue:\n",
    "        _, i = heapq.heappop(queue)\n",
    "        if fast:\n",
    "            partners = set().union(*(index[(l.pred, not l.positive)] for l in clauses[i])) | {i}\n",
    "        else:\n",
    "            partners = usable + [i]\n",
    "        for j in sorted(partners):\n",
    "            for r in resolvents(rename(clauses[i]), rename(clauses[j])):\n",
    "                generated += 1\n",
    "                how = (i, j)\n",
    "                if fast and r:\n",
    "                    before, r = r, simplify(r)\n",
    "                    if r is None:\n",
    "                        continue\n",
    "                    if r != before:\n",
    "                        how = (i, j, \"simplified with unit clauses\")\n",
    "                if not r:\n",
    "                    clauses.append(r)\n",
    "                    origin.append(how)\n",
    "                    return True, _proof(clauses, origin)\n",
    "                if len(r) > MAX_CLAUSE_LENGTH or any(depth(t) > MAX_TERM_DEPTH for l in r for t in l.args):\n",
    "                    continue\n",
    "                k = store(r, how)\n",
    "                if k is not None:\n",
    "                    heapq.heappush(queue, (len(r), k))\n",
    "            if generated > MAX_RESOLVENTS or time.perf_counter() - start > MAX_SECONDS:\n",
    "                return False, [f\"no contradiction found within the search limit ({generated} resolvents)\"]\n",
    "        use(i)\n",
    "    return False, [f\"no contradiction: search space exhausted ({generated} resolvents)\"]\n",
    "\n",
    "\n",
    "def _proof(clauses, origin):\n",
    "    order, seen, stack = [], set(), [(len(clauses) - 1, False)]\n",
    "    while stack:                                   # iterative post-order walk over the proof tree\n",
    "        i, expanded = stack.pop()\n",
    "        if expanded:\n",
    "            order.append(i)\n",
    "        elif i not in seen:\n",
    "            seen.add(i)\n",
    "            stack.append((i, True))\n",
    "            if isinstance(origin[i], tuple):\n",
    "                stack += [(origin[i][1], False), (origin[i][0], False)]\n",
    "    lines = []\n",
    "    for i in order:\n",
    "        c = \" ∨ \".join(sorted(map(str, clauses[i]))) or \"□ (contradiction)\"\n",
    "        o = origin[i]\n",
    "        how = o if isinstance(o, str) else f\"C{o[0]} + C{o[1]}\" + (f\", {o[2]}\" if len(o) > 2 else \"\")\n",
    "        lines.append(f\"C{i}: {c}   [{how}]\")\n",
    "    return lines"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8d1205d8",
