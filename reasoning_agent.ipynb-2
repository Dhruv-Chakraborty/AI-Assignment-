   "source": [
    "## 7. Prediction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "59bc8225",
   "metadata": {},
   "outputs": [],
   "source": [
    "EQUALITY = [frozenset([Literal(True, \"equals\", (Var(\"e1\"), Var(\"e1\")))]),\n",
    "            frozenset([Literal(False, \"equals\", (Var(\"e1\"), Var(\"e2\"))), Literal(True, \"equals\", (Var(\"e2\"), Var(\"e1\")))])]\n",
    "\n",
    "\n",
    "def equality_axioms(clauses):\n",
    "    \"\"\"Reflexivity, symmetry, transitivity, and substitution for every predicate: x=y ∧ P(..x..) → P(..y..).\"\"\"\n",
    "    x, y, z = Var(\"e1\"), Var(\"e2\"), Var(\"e3\")\n",
    "    axioms = EQUALITY + [frozenset([Literal(False, \"equals\", (x, y)), Literal(False, \"equals\", (y, z)),\n",
    "                                    Literal(True, \"equals\", (x, z))])]\n",
    "    arities = {(l.pred, len(l.args)) for c in clauses for l in c if l.pred != \"equals\" and l.args}\n",
    "    for pred, n in sorted(arities):\n",
    "        for k in range(n):\n",
    "            before = tuple(Var(f\"a{i}\") for i in range(n))\n",
    "            after = before[:k] + (Var(\"b\"),) + before[k + 1:]\n",
    "            axioms.append(frozenset([Literal(False, \"equals\", (before[k], Var(\"b\"))),\n",
    "                                     Literal(False, pred, before), Literal(True, pred, after)]))\n",
    "    return axioms\n",
    "\n",
    "\n",
    "def split_lines(value):\n",
    "    if value is None or (isinstance(value, float) and pd.isna(value)):\n",
    "        return []\n",
    "    if isinstance(value, (list, tuple)) or hasattr(value, \"tolist\"):\n",
    "        return [str(v).strip() for v in list(value) if str(v).strip()]\n",
    "    return [s.strip() for s in str(value).split(\"\\n\") if s.strip()]\n",
    "\n",
    "\n",
    "TRUTH_AXIOMS = [frozenset([Literal(True, \"⊤\", ())]), frozenset([Literal(False, \"⊥\", ())])]\n",
    "\n",
    "\n",
    "def predict(premises, query, fast=True):\n",
    "    \"\"\"flag = True iff the query is entailed by the premises (classical first-order logic).\n",
    "    Unquantified variables are universal in the premises; in the query they ask \"is there some x\".\"\"\"\n",
    "    DISPLAY.clear()\n",
    "    DISPLAY.update({\"⊤\": \"⊤\", \"⊥\": \"⊥\"})\n",
    "    kb, skipped = [], []\n",
    "    for p in premises:\n",
    "        try:\n",
    "            kb += to_clauses(parse_fol(p))\n",
    "        except (ParseError, RecursionError):\n",
    "            skipped.append(p)                                  # unreadable premise: reason without it\n",
    "    try:\n",
    "        q = parse_fol(query)\n",
    "    except (ParseError, RecursionError):\n",
    "        return {\"flag\": False, \"engine\": \"parse error\", \"trace\": [\"query could not be parsed\"], \"skipped\": skipped}\n",
    "    goal = to_clauses((\"not\", q))                              # refutation: add the negated query\n",
    "    everything = kb + goal\n",
    "    if any(l.pred in (\"⊤\", \"⊥\") for c in everything for l in c):\n",
    "        kb += TRUTH_AXIOMS\n",
    "    if any(l.pred == \"equals\" for c in everything for l in c):\n",
    "        kb += equality_axioms(everything)\n",
    "    engine = \"resolution (fast)\" if fast else \"resolution (baseline)\"\n",
    "    flag, trace = resolution(kb, goal, fast) if goal else (False, [\"the query is a contradiction\"])\n",
    "    trace.append(f\"⇒ {'entailed' if flag else 'not entailed'}: flag = {flag}\")\n",
    "    return {\"flag\": flag, \"engine\": engine, \"trace\": trace, \"skipped\": skipped}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bedd2f30",
   "metadata": {},
   "source": [
    "## 8. Reading the input"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f46124e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import ast\n",
    "import os\n",
    "from collections import Counter\n",
    "\n",
    "COLUMN_NAMES = {\n",
    "    \"id\": [\"id\", \"idx\", \"question_id\", \"example_id\", \"uid\"],\n",
    "    \"context\": [\"context\", \"premises\", \"knowledge_base\", \"kb\", \"theory\", \"facts\", \"premises-fol\", \"premises_fol\"],\n",
    "    \"statement\": [\"statement\", \"query\", \"question\", \"conclusion\", \"hypothesis\", \"conclusion-fol\", \"conclusion_fol\"],\n",
    "    \"label\": [\"label\", \"flag\", \"answer\", \"gold\", \"target\", \"truth\"],\n",
    "}\n",
    "\n",
    "\n",
    "def find_column(df, kind):\n",
    "    lower = {c.lower().strip(): c for c in df.columns}\n",
    "    return next((lower[n] for n in COLUMN_NAMES[kind] if n in lower), None)\n",
    "\n",
    "\n",
    "def to_bool(value):\n",
    "    \"\"\"True / 'true' / 'yes' / 1 -> True. Anything else (False, Uncertain, Unknown, ...) -> False.\"\"\"\n",
    "    return str(value).strip().lower() in {\"true\", \"yes\", \"1\", \"1.0\", \"t\", \"y\", \"entailment\", \"entailed\"}\n",
    "\n",
    "\n",
    "def clean_formula(text):\n",
    "    text = re.sub(r\"^\\s*(query|statement|conclusion|premise|fact|rule)\\s*\\d*\\s*[:.)-]\\s*\", \"\", str(text), flags=re.I)\n",
    "    return text.strip().rstrip(\".?!;\").strip()\n",
    "\n",
    "\n",
    "def split_premises(context):\n",
    "    \"\"\"Knowledge base -> list of formulas: a list, one formula per line, or formulas separated by ';' or '. '.\"\"\"\n",
    "    if isinstance(context, (list, tuple)):\n",
    "        items = list(context)\n",
    "    else:\n",
    "        text = str(context).strip()\n",
    "        items = [text]\n",
    "        if text.startswith(\"[\") and text.endswith(\"]\"):\n",
    "            try:\n",
    "                items = list(ast.literal_eval(text))\n",
    "            except (ValueError, SyntaxError):\n",
    "                pass\n",
    "    out = []\n",
    "    for item in items:\n",
    "        for line in re.split(r\"\\n|;\", str(item)):\n",
    "            line = clean_formula(line)\n",
    "            if not line:\n",
    "                continue\n",
    "            try:\n",
    "                parse_fol(line)\n",
    "                out.append(line)\n",
    "            except ParseError:                       # several formulas on one line: \"P(a). Q(b). ...\"\n",
    "                out += [clean_formula(p) for p in re.split(r\"\\.\\s+\", line) if clean_formula(p)]\n",
    "    return out\n",
    "\n",
    "\n",
    "def reason(context, statement):\n",
    "    \"\"\"One example (logic) -> {flag, engine, trace, premises, query}.\"\"\"\n",
    "    premises, query = split_premises(context), clean_formula(statement)\n",
    "    try:\n",
    "        out = predict(premises, query, fast=True)\n",
    "    except Exception as e:                           # never stop the whole run because of one example\n",
    "        out = {\"flag\": False, \"engine\": \"error\", \"trace\": [str(e)], \"skipped\": premises}\n",
    "    out.update(premises=premises, query=query)\n",
    "    return out\n",
    "\n",
    "\n",
    "def show(example_id, out, gold=None):\n",
    "    print(f\"--- example {example_id}\")\n",
    "    print(\"KB:   \", \"\\n       \".join(out[\"premises\"]))\n",
    "    print(\"QUERY:\", out[\"query\"])\n",
    "    print(\"engine:\", out[\"engine\"], f\"| premises that could not be parsed: {out['skipped']}\" if out.get(\"skipped\") else \"\")\n",
    "    for line in out[\"trace\"]:\n",
    "        print(\"   \", line)\n",
    "    print(f\"prediction: {out['flag']}\" + (\"\" if gold is None else f\"   | gold: {gold}\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "94ffd0bd",
   "metadata": {},
   "source": [
    "## 9. Inference"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0a119d91",
   "metadata": {},
   "outputs": [],
   "source": [
    "from IPython.display import display\n",
    "\n",
    "\n",
    "def run_file(path, output=OUTPUT_CSV):\n",
    "    df = pd.read_csv(path)\n",
    "    id_col, ctx_col, st_col, label_col = (find_column(df, k) for k in [\"id\", \"context\", \"statement\", \"label\"])\n",
    "    if ctx_col is None or st_col is None:\n",
    "        raise ValueError(f\"need a context and a statement column, found {list(df.columns)}\")\n",
    "    ids = df[id_col].tolist() if id_col else list(range(len(df)))\n",
    "\n",
    "    flags, total = [], 0.0\n",
    "    for k in range(len(df)):\n",
    "        context, statement = df.iloc[k][ctx_col], df.iloc[k][st_col]\n",
    "        start = time.perf_counter()\n",
    "        out = reason(context, statement)\n",
    "        total += time.perf_counter() - start\n",
    "        flags.append(bool(out[\"flag\"]))\n",
    "\n",
    "    pd.DataFrame({\"id\": ids, \"flag\": flags}).to_csv(output, index=False)\n",
    "    print(f\"{len(df)} examples from {os.path.basename(str(path))} -> predictions saved to {output}\")\n",
    "    summary = {\"Examples\": len(df), \"Total inference time (s)\": round(total, 3),\n",
    "               \"Time per example (ms)\": round(1000 * total / max(len(df), 1), 3)}\n",
    "    if label_col:\n",
    "        gold = [to_bool(g) for g in df[label_col]]\n",
    "        tp = sum(f and g for f, g in zip(flags, gold))\n",
    "        tn = sum(not f and not g for f, g in zip(flags, gold))\n",
    "        fp = sum(f and not g for f, g in zip(flags, gold))\n",
    "        fn = sum(not f and g for f, g in zip(flags, gold))\n",
    "        summary.update({\"Accuracy (%)\": round(100 * (tp + tn) / len(df), 2),\n",
    "                        \"Precision (%)\": round(100 * tp / (tp + fp), 2) if tp + fp else None,\n",
    "                        \"Recall (%)\": round(100 * tp / (tp + fn), 2) if tp + fn else None})\n",
    "        display(pd.DataFrame([summary], index=[\"Result\"]))\n",
    "        display(pd.DataFrame({\"Predicted True\": [f\"TP = {tp}\", f\"FP = {fp}\"],\n",
    "                              \"Predicted False\": [f\"FN = {fn}\", f\"TN = {tn}\"]},\n",
    "                             index=[\"Gold True\", \"Gold False\"]))\n",
    "    else:\n",
    "        display(pd.DataFrame([summary], index=[\"Result\"]))\n",
    "        print(\"No label column in the input: accuracy cannot be computed.\")\n",
    "\n",
    "\n",
    "if os.path.exists(INPUT_CSV):\n",
    "    run_file(INPUT_CSV)\n",
    "else:\n",
    "    print(f\"{INPUT_CSV} not found: set INPUT_CSV in the configuration cell to the file to predict.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "85dec064",
   "metadata": {},
   "source": [
    "## 10. English templates (only for reproducing the reported results)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "798394c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "class TranslationError(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "RULE_PATTERNS = [\n",
    "    r\"^if (.+?),? then (.+)$\",\n",
    "    r\"^assuming (.+?),? we can say (?:that )?(.+)$\",\n",
    "    r\"^based on (.+?),? it is evident that (.+)$\",\n",
    "    r\"^given that (.+?),? it follows that (.+)$\",\n",
    "    r\"^when (.+?),? we can conclude (?:that )?(.+)$\",\n",
    "    r\"^since (.+?),? (?:it follows that |then )?(.+)$\",\n",
    "    r\"^(.+?) if (.+)$\",\n",
    "]\n",
    "ALL_PATTERN = r\"^all (\\w+(?:,? \\w+)*) (?:things|people) are (.+)$|^(\\w+(?:,? \\w+)*) (?:things|people) are (.+)$\"\n",
    "VARIABLE_WORDS = {\"someone\", \"something\", \"they\", \"it\", \"he\", \"she\", \"anyone\", \"anything\"}\n",
    "# words that signal a sentence too complex for the templates (it is left untranslated)\n",
    "COMPLEX_WORDS = {\"who\", \"which\", \"whom\", \"whose\", \"all\", \"every\", \"each\", \"some\", \"any\", \"no\", \"none\",\n",
    "                 \"either\", \"neither\", \"nor\", \"or\", \"unless\", \"because\", \"only\", \"both\", \"than\", \"there\",\n",
    "                 \"whenever\", \"if\", \"then\", \"but\", \"although\", \"were\", \"was\", \"will\", \"would\"}\n",
    "IRREGULAR = {\"has\": \"have\", \"does\": \"do\", \"is\": \"be\", \"are\": \"be\", \"goes\": \"go\"}\n",
    "\n",
    "\n",
    "def lemma(w):\n",
    "    if w in IRREGULAR:\n",
    "        return IRREGULAR[w]\n",
    "    if w.endswith(\"ies\") and len(w) > 4:\n",
    "        return w[:-3] + \"y\"\n",
    "    if w.endswith((\"ches\", \"shes\", \"sses\", \"xes\", \"zes\")):\n",
    "        return w[:-2]\n",
    "    if w.endswith(\"s\") and not w.endswith(\"ss\"):\n",
    "        return w[:-1]\n",
    "    return w\n",
    "\n",
    "\n",
    "def camel(words):\n",
    "    return \"\".join(re.sub(r\"[^A-Za-z0-9]\", \"\", w).capitalize() for w in words if re.sub(r\"[^A-Za-z0-9]\", \"\", w))\n",
    "\n",
    "\n",
    "def sentences(text):\n",
    "    text = re.sub(r\"\\b(facts|rules)\\s*:\", \" \", str(text), flags=re.I)\n",
    "    return [s.strip() for s in re.split(r\"(?<=[.!?])\\s+|\\n+\", text.strip()) if s.strip()]\n",
    "\n",
    "\n",
    "def clean(s):\n",
    "    return re.sub(r\"\\s+\", \" \", re.sub(r\"[.!?]+$\", \"\", s.strip().lower()))\n",
    "\n",
    "\n",
    "def entities_from(texts):\n",
    "    \"\"\"Capitalised names in facts/statements (\"Stanford University\", \"the river\") -> matched in lower-case rules.\"\"\"\n",
    "    found = set()\n",
    "    for t in texts:\n",
    "        for s in sentences(t):\n",
    "            words = s.rstrip(\".!?\").split()\n",
    "            if not words:\n",
    "                continue\n",
    "            if words[0] in (\"The\", \"A\", \"An\"):\n",
    "                if len(words) > 1:\n",
    "                    found.add(\"the \" + words[1].lower())\n",
    "                continue\n",
    "            run = []\n",
    "            for w in words:\n",
    "                if not w[:1].isupper():\n",
    "                    break\n",
    "                run.append(w.lower())\n",
    "            if run:\n",
    "                found.add(\" \".join(run))\n",
    "    return sorted(found, key=len, reverse=True)\n",
    "\n",
    "\n",
    "def atom(phrase, entities, previous_subject=None):\n",
    "    \"\"\"'the wall dances gracefully' -> 'DanceGracefully(Wall)' ; 'charlie is not fast' -> '¬Fast(Charlie)'.\"\"\"\n",
    "    words = clean(phrase).split()\n",
    "    if not words or len(words) > 8 or COMPLEX_WORDS & set(words) or \",\" in phrase:\n",
    "        raise TranslationError(f\"not a simple statement: {phrase!r}\")\n",
    "    phrase = \" \".join(words)\n",
    "    starts_with_entity = any(phrase == e or phrase.startswith(e + \" \") for e in entities)\n",
    "    if previous_subject and len(words) <= 2 and words[0] not in VARIABLE_WORDS | {\"the\"} and not starts_with_entity:\n",
    "        subject, rest = previous_subject, (words if words[0] in (\"is\", \"are\") else [\"is\"] + words)\n",
    "    elif words[0] in VARIABLE_WORDS:\n",
    "        subject, rest = \"x\", words[1:]\n",
    "    else:\n",
    "        e = next((e for e in entities if phrase == e or phrase.startswith(e + \" \")), None)\n",
    "        if e:\n",
    "            subject, rest = camel(e.split()[1:] if e.startswith(\"the \") else e.split()), words[len(e.split()):]\n",
    "        elif words[0] == \"the\" and len(words) > 2:\n",
    "            subject, rest = camel(words[1:2]), words[2:]\n",
    "        else:\n",
    "            subject, rest = camel(words[:1]), words[1:]\n",
    "    negated = False\n",
    "    if rest and rest[0] in (\"is\", \"are\"):\n",
    "        rest = rest[1:]\n",
    "        if rest[:1] == [\"not\"]:\n",
    "            negated, rest = True, rest[1:]\n",
    "        if rest[:1] and rest[0] in (\"a\", \"an\", \"the\"):\n",
    "            rest = rest[1:]\n",
    "    elif rest[:2] in ([\"does\", \"not\"], [\"do\", \"not\"]):\n",
    "        negated, rest = True, rest[2:]\n",
    "    elif rest[:2] == [\"can\", \"not\"] or rest[:1] == [\"cannot\"]:\n",
    "        negated, rest = True, [\"can\"] + rest[(2 if rest[0] == \"can\" else 1):]\n",
    "    elif rest:\n",
    "        rest = [lemma(rest[0])] + rest[1:]\n",
    "    rest = [w for w in rest if w not in (\"a\", \"an\", \"the\")]       # \"uses a laptop\" -> UseLaptop\n",
    "    if not rest or not subject:\n",
    "        raise TranslationError(f\"no predicate in {phrase!r}\")\n",
    "    text = f\"{camel(rest)}({subject})\"\n",
    "    return (\"¬\" + text if negated else text), subject\n",
    "\n",
    "\n",
    "def conjunction(phrase, entities):\n",
    "    out, subject = [], None\n",
    "    for part in re.split(r\",? and \", clean(phrase)):\n",
    "        a, subject = atom(part, entities, subject)\n",
    "        out.append(a)\n",
    "    return out\n",
    "\n",
    "\n",
    "def sentence_to_fol(sentence, entities):\n",
    "    \"\"\"One English sentence -> list of FOL strings (raises TranslationError if no template fits).\"\"\"\n",
    "    s = clean(sentence)\n",
    "    m = re.match(ALL_PATTERN, s)\n",
    "    if m:\n",
    "        adjectives, head = (m.group(1), m.group(2)) if m.group(1) else (m.group(3), m.group(4))\n",
    "        body = [f\"{camel([a])}(x)\" for a in re.split(r\",? \", adjectives) if a]\n",
    "        return [f\"∀x (({' ∧ '.join(body)}) → {h})\" for h in conjunction(\"it is \" + head, entities)]\n",
    "    for pattern in RULE_PATTERNS:\n",
    "        m = re.match(pattern, s)\n",
    "        if m:\n",
    "            body_text, head_text = m.group(1), m.group(2)\n",
    "            if pattern == r\"^(.+?) if (.+)$\":\n",
    "                body_text, head_text = head_text, body_text\n",
    "            body, head = conjunction(body_text, entities), conjunction(head_text, entities)\n",
    "            rules = [f\"({' ∧ '.join(body)}) → {h}\" for h in head]\n",
    "            return [f\"∀x ({r})\" if \"(x)\" in r else r for r in rules]\n",
    "    return conjunction(s, entities)\n",
    "\n",
    "\n",
    "# CounterBench: causal story + \"Would Y occur if not X instead of X?\" -> twin network in FOL\n",
    "def _lit(text):\n",
    "    text = text.strip()\n",
    "    return (text[4:].strip(), False) if text.startswith(\"not \") else (text, True)\n",
    "\n",
    "\n",
    "def parse_causal_story(text):\n",
    "    \"\"\"'A causes B, C and D, B or not C causes E, ...' -> rules [(body literals, effect, positive)].\n",
    "    Clauses are separated by commas: the last comma-chunk before each 'cause(s)' is its subject.\"\"\"\n",
    "    text = re.sub(r\"\\b\\w+\\s*~\\s*bern\\([\\d.]+\\)\\.?\", \" \", clean(text))      # drop 'X~Bern(0.4)' (priors)\n",
    "    observations = []\n",
    "    m = re.search(r\"\\bwe observed (?:that )?(.+)$\", text)\n",
    "    if m:\n",
    "        observations = [_lit(p) for p in re.split(r\",? and |, \", m.group(1).strip(\" .\"))]\n",
    "        text = text[:m.start()]\n",
    "    text = re.sub(r\"^we know that \", \"\", text.strip().rstrip(\".\").strip())\n",
    "    text = re.sub(r\"\\bha(?:s|ve) a direct effect on\\b\", \"causes\", text).replace(\".\", \",\")\n",
    "    verbs = list(re.finditer(r\"\\b(?:together\\s+)?causes?\\b\", text))\n",
    "    if not verbs:\n",
    "        raise TranslationError(\"no causal statement\")\n",
    "    bounds = [0] + [x for v in verbs for x in (v.start(), v.end())] + [len(text)]\n",
    "    segments = [text[bounds[k]:bounds[k + 1]] for k in range(0, len(bounds), 2)]\n",
    "    chunks = lambda seg: [re.sub(r\"^and\\s+\", \"\", c.strip()) for c in seg.split(\",\") if c.strip()]\n",
    "    subjects, effects = [], []\n",
    "    for k in range(len(verbs)):\n",
    "        cs = chunks(segments[k])\n",
    "        if not cs:\n",
    "            raise TranslationError(\"causal statement without a subject\")\n",
    "        if k > 0:\n",
    "            effects.append(cs[:-1])\n",
    "        subjects.append(cs[-1])\n",
    "    effects.append(chunks(segments[-1]))\n",
    "    rules = []\n",
    "    for subj, effs in zip(subjects, effects):\n",
    "        if \" or \" in subj:\n",
    "            bodies = [[_lit(x)] for x in subj.split(\" or \")]                  # A or B causes C\n",
    "        else:\n",
    "            bodies = [[_lit(x) for x in subj.split(\" and \")]]                 # A and B (together) cause C\n",
    "        for e in effs:\n",
    "            for x in e.split(\" and \"):                                         # A causes B and C\n",
    "                var, positive = _lit(x)\n",
    "                rules += [(body, var, positive) for body in bodies]\n",
    "    return rules, observations\n",
    "\n",
    "\n",
    "def parse_question(question):\n",
    "    q = clean(question)\n",
    "    if q.startswith((\"assume \", \"suppose \", \"imagine \")):          # nested: both suppositions are interventions\n",
    "        m = re.search(r\"would (not )?(\\w+) occur(?: if (.+?))?$\", q)\n",
    "        if not m:\n",
    "            raise TranslationError(f\"unknown question: {question!r}\")\n",
    "        parts = re.findall(r\"(?:assume|suppose|imagine) (?:that )?(.+?)(?=,|\\.|$| and based)\", q[:m.start()])\n",
    "        do = [_lit(x) for p in parts for x in re.split(r\",? and \", p.strip())]\n",
    "        do += [_lit(p) for p in re.split(r\",? and \", m.group(3))] if m.group(3) else []\n",
    "        return (m.group(2), m.group(1) is None), do, []\n",
    "    m = re.match(r\"^would (not )?(\\w+) occur(?: if (.+?))?(?: instead of (.+))?$\", q)\n",
    "    if not m:\n",
    "        raise TranslationError(f\"unknown question: {question!r}\")\n",
    "    do = [_lit(p) for p in re.split(r\",? and \", m.group(3))] if m.group(3) else []\n",
    "    factual = [_lit(p) for p in re.split(r\",? and \", m.group(4))] if m.group(4) else []\n",
    "    return (m.group(2), m.group(1) is None), do, factual\n",
    "\n",
    "\n",
    "def is_counterfactual(context, statement):\n",
    "    return bool(re.search(r\"\\bwould\\b.*\\boccur\\b\", f\"{statement} {context}\", re.I)) and \\\n",
    "        bool(re.search(r\"\\bcauses?\\b\", str(context), re.I))\n",
    "\n",
    "\n",
    "def counterfactual_to_fol(context, statement):\n",
    "    \"\"\"Twin network: V_a (actual world) and V_c (counterfactual world) for every variable.\n",
    "    Equations V ↔ (cause1 ∨ cause2 ...) in both worlds; background variables shared (R_c ↔ R_a);\n",
    "    intervened variables fixed in the counterfactual world; facts about the actual world added.\"\"\"\n",
    "    question = statement if re.search(r\"\\bwould\\b\", str(statement), re.I) else \\\n",
    "        re.search(r\"[^.?]*\\bwould\\b[^?]*\\??\", str(context), re.I).group(0)\n",
    "    story = str(context).replace(question, \"\") + (f\" {statement}\" if question != statement else \"\")\n",
    "    rules, observations = parse_causal_story(story)\n",
    "    target, do, factual = parse_question(question)\n",
    "    do = dict(do)\n",
    "    caused = {v for _, v, _ in rules}\n",
    "    variables = caused | {v for b, _, _ in rules for v, _ in b} | {target[0]} | set(do) | {v for v, _ in factual + observations}\n",
    "    lit = lambda v, positive, w: f\"{v}_{w}\" if positive else f\"¬{v}_{w}\"\n",
    "    premises = []\n",
    "    for w in (\"a\", \"c\"):\n",
    "        for v in sorted(caused):\n",
    "            if w == \"c\" and v in do:\n",
    "                continue\n",
    "            terms = []\n",
    "            for body, effect, positive in rules:\n",
    "                if effect == v:\n",
    "                    conj = \" ∧ \".join(lit(b, p, w) for b, p in body)\n",
    "                    conj = f\"({conj})\" if len(body) > 1 else conj\n",
    "                    terms.append(conj if positive else f\"¬{conj}\")\n",
    "            premises.append(f\"{v}_{w} ↔ ({' ∨ '.join(terms)})\")\n",
    "    premises += [f\"{v}_c ↔ {v}_a\" for v in sorted(variables - caused) if v not in do]\n",
    "    premises += [lit(v, val, \"c\") for v, val in do.items()]\n",
    "    premises += [lit(v, val, \"a\") for v, val in factual + observations]\n",
    "    return premises, lit(target[0], target[1], \"c\")\n",
    "\n",
    "\n",
    "def to_logic(context, statement):\n",
    "    \"\"\"English example -> (premise formulas, query formula or None). Used only for RuleTaker and CounterBench.\"\"\"\n",
    "    if is_counterfactual(context, statement):\n",
    "        return counterfactual_to_fol(context, statement)\n",
    "    entities = entities_from([context, statement])\n",
    "\n",
    "    def translate(s):\n",
    "        try:\n",
    "            return sentence_to_fol(s, entities)\n",
    "        except TranslationError:\n",
    "            return None                                        \n",
    "    premises = [f for s in sentences(context) for f in (translate(s) or [])]\n",
    "    query = translate(statement)\n",
    "    if not query:\n",
    "        return premises, None                                 \n",
    "    return premises, \" ∧ \".join(f\"({q})\" for q in query) if len(query) > 1 else query[0]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4541ad7d",
   "metadata": {},
   "source": [
    "## 11. Rresults: load the public data and run both engines"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d978841b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RuleTaker and CounterBench are English: the templates (Section 11) turn them into logic.\n",
    "# FOLIO comes with logic and is used as given. Both engines reason on the same logic;\n",
    "# only the reasoning time is measured.\n",
    "ENGINES = {\"baseline\": False, \"fast\": True}         \n",
    "\n",
    "\n",
    "def load_public_data(limit=RECHECK_LIMIT):\n",
    "    from datasets import load_dataset\n",
    "    from huggingface_hub import get_token, hf_hub_download, list_repo_files, login\n",
    "    if get_token() is None:                              # FOLIO is gated: log in once\n",
    "        login()\n",
    "    rows = []\n",
    "\n",
    "    def add(dataset, split, i, premises, query, label):\n",
    "        rows.append({\"id\": f\"{dataset.lower()}_{split}_{i:05d}\", \"dataset\": dataset, \"split\": split,\n",
    "                     \"premises\": premises, \"query\": query or \"\", \"label\": str(label), \"gold\": to_bool(label)})\n",
    "\n",
    "    ruletaker = load_dataset(\"jise/ruletaker\")\n",
    "    for split in ruletaker:\n",
    "        for i, r in enumerate(ruletaker[split]):\n",
    "            if limit and i >= limit:\n",
    "                break\n",
    "            add(\"RuleTaker\", split, i, *to_logic(r[\"context\"], r[\"statement\"]), r[\"flag\"])\n",
    "\n",
    "    repo = \"CounterBench/CounterBench\"\n",
    "    files = [f for f in list_repo_files(repo, repo_type=\"dataset\") if f.endswith(\".json\")]\n",
    "    frames = [pd.read_json(hf_hub_download(repo, f, repo_type=\"dataset\")) for f in files]\n",
    "    counterbench = pd.concat([f for f in frames if {\"given_info\", \"question\", \"answer\"} <= set(f.columns)],\n",
    "                             ignore_index=True)\n",
    "    for i, r in counterbench.iterrows():\n",
    "        if limit and i >= limit:\n",
    "            break\n",
    "        add(\"CounterBench\", \"all\", i, *to_logic(r[\"given_info\"], r[\"question\"]), r[\"answer\"])\n",
    "\n",
    "    folio = load_dataset(\"yale-nlp/FOLIO\")\n",
    "    for split in folio:\n",
    "        for i, r in enumerate(folio[split]):\n",
    "            if limit and i >= limit:\n",
    "                break\n",
    "            add(\"FOLIO\", split, i, split_lines(r[\"premises-FOL\"]), r[\"conclusion-FOL\"], r[\"label\"])\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def run_engines(data):\n",
    "    for name, fast in ENGINES.items():\n",
    "        flags, secs = [], []\n",
    "        for premises, query in tqdm(zip(data[\"premises\"], data[\"query\"]), total=len(data), desc=f\"{name} resolution\"):\n",
    "            start = time.perf_counter()\n",
    "            try:\n",
    "                flags.append(bool(query) and predict(premises, query, fast=fast)[\"flag\"])\n",
    "            except Exception:                        # one bad example must not stop the run\n",
    "                flags.append(False)\n",
    "            secs.append(time.perf_counter() - start)\n",
    "        data[f\"{name} flag\"], data[f\"{name} s\"] = flags, secs\n",
    "    return data\n",
    "\n",
    "\n",
    "def summary(df):\n",
    "    \"\"\"Accuracy and reasoning time of both engines on one group of examples.\"\"\"\n",
    "    row = {\"examples\": len(df)}\n",
    "    for name in ENGINES:\n",
    "        row[f\"{name} acc %\"] = round(100 * (df[f\"{name} flag\"] == df[\"gold\"]).mean(), 2)\n",
    "    for name in ENGINES:\n",
    "        row[f\"{name} time s\"] = round(df[f\"{name} s\"].sum(), 3)\n",
    "    row[\"speed-up\"] = round(df[\"baseline s\"].sum() / max(df[\"fast s\"].sum(), 1e-6), 1)\n",
    "    return row\n",
    "\n",
    "\n",
    "if RECHECK_RESULTS:\n",
    "    from tqdm.auto import tqdm\n",
    "    pd.set_option(\"display.width\", 200)\n",
    "    data = run_engines(load_public_data())\n",
    "    data[\"uncertain\"] = data[\"label\"].str.lower() == \"uncertain\"\n",
    "    main = data[~data[\"uncertain\"]]                    # FOLIO 'Uncertain' removed (Sections 12 and 13)\n",
    "    pd.DataFrame({\"id\": data[\"id\"], \"context\": data[\"premises\"].map(\"\\n\".join),\n",
    "                  \"statement\": data[\"query\"], \"label\": data[\"gold\"]}).to_csv(\"public_dev_logic.csv\", index=False)\n",
    "    pd.DataFrame({\"id\": data[\"id\"], \"flag\": data[\"fast flag\"]}).to_csv(\"submission.csv\", index=False)\n",
    "    print(f\"{len(data)} examples done: predictions (fast resolution) saved to submission.csv, \"\n",
    "          f\"logic saved to public_dev_logic.csv\")\n",
    "else:\n",
    "    print(\"Skipped (RECHECK_RESULTS = False)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3d4705f6",
   "metadata": {},
   "source": [
    "## 12. Results per split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "693c43d7",
   "metadata": {},
   "outputs": [],
   "source": [
    "if RECHECK_RESULTS:\n",
    "    per_split = pd.DataFrame([{\"dataset\": d, \"split\": s, **summary(g)}\n",
    "                              for (d, s), g in main.groupby([\"dataset\", \"split\"], sort=False)])\n",
    "    print(\"FOLIO without 'Uncertain'\\n\")\n",
    "    print(per_split.to_string(index=False))\n",
    "    per_split.to_csv(\"results_per_split.csv\", index=False)\n",
    "else:\n",
    "    print(\"Skipped (RECHECK_RESULTS = False)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5f900f6f",
